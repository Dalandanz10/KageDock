
<UserControl x:Class="KageDock.Views.KazeSunlitBreezeEffect"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="100"
             Height="30"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             IsHitTestVisible="False"
             Focusable="False"
             Visibility="Collapsed"
             ClipToBounds="True">

    <Grid Width="100"
          Height="30"
          ClipToBounds="True"
          IsHitTestVisible="False">

        <!-- Existing Kaze breeze ribbons -->
        <Canvas x:Name="Layer"
                Width="100"
                Height="30"
                IsHitTestVisible="False"
                ClipToBounds="True"/>

        <!-- Independent Solar Flare effect -->
        <Canvas x:Name="SolarFlareLayer"
                Width="100"
                Height="30"
                IsHitTestVisible="False"
                ClipToBounds="True"/>

    </Grid>

</UserControl>
