
<UserControl x:Class="KageDock.Views.KageYozakuraEffect"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             IsHitTestVisible="False"
             Focusable="False"
             ClipToBounds="True">

    <Canvas x:Name="Layer"
            Width="100"
            Height="30"
            ClipToBounds="True"
            IsHitTestVisible="False">

        <!-- Ambient moonlight -->
        <Ellipse x:Name="AmbientGlow"
                 Canvas.Left="-5"
                 Canvas.Top="-12"
                 Width="110"
                 Height="54"
                 Opacity="0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#20FFFFFF" Offset="0"/>
                    <GradientStop Color="#0CFFFFFF" Offset="0.55"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Left eye soft glow -->
        <Ellipse x:Name="LeftEyeGlow"
                 Canvas.Left="17"
                 Canvas.Top="5"
                 Width="34"
                 Height="20"
                 Opacity="0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#DFFFFFFF" Offset="0"/>
                    <GradientStop Color="#A9D9F5FF" Offset="0.30"/>
                    <GradientStop Color="#66A9D9FF" Offset="0.58"/>
                    <GradientStop Color="#00A9D9FF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Right eye soft glow -->
        <Ellipse x:Name="RightEyeGlow"
                 Canvas.Left="49"
                 Canvas.Top="5"
                 Width="34"
                 Height="20"
                 Opacity="0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#DFFFFFFF" Offset="0"/>
                    <GradientStop Color="#A9D9F5FF" Offset="0.30"/>
                    <GradientStop Color="#66A9D9FF" Offset="0.58"/>
                    <GradientStop Color="#00A9D9FF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Blossoms are created and reused by the code-behind. -->

    </Canvas>
</UserControl>
