<UserControl x:Class="KageDock.Views.TimeSuiteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

       <!-- Rounded glass button style -->
        <Style x:Key="GlassButtonStyle"
            TargetType="{x:Type Button}">

            <Setter Property="Background" Value="#202A3542"/>
            <Setter Property="Foreground" Value="#DCE5F0"/>
            <Setter Property="BorderBrush" Value="#35FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">

                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ButtonScale"
                                                    ScaleX="1"
                                                    ScaleY="1"/>
                                    <TranslateTransform x:Name="ButtonOffset"
                                                        Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#32FFFFFF"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#65FFFFFF"/>

                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonOffset"
                                                Storyboard.TargetProperty="Y"
                                                To="-1"
                                                Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>

                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonOffset"
                                                Storyboard.TargetProperty="Y"
                                                To="0"
                                                Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Press -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#45FFFFFF"/>

                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="0.94"
                                                Duration="0:0:0.07"/>

                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="0.94"
                                                Duration="0:0:0.07"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>

                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="1"
                                                Duration="0:0:0.12"/>

                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="1"
                                                Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassTimeInputStyle"
            TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#202A3542"/>
            <Setter Property="Foreground" Value="#F4F8FF"/>
            <Setter Property="BorderBrush" Value="#45FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#6688AACC"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="Background"
                                        Value="#303D4A58"/>
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#70FFFFFF"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="Background"
                                        Value="#35465360"/>
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#90FFFFFF"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border CornerRadius="16"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            Padding="14">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- MODE TABS -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="TimerTab"
                        Grid.Column="0"
                        Content="TIMER"
                        Style="{StaticResource GlassButtonStyle}"
                        Background="#32FFFFFF"
                        Foreground="White"
                        Padding="8,7"
                        Margin="2"/>

                <Button x:Name="StopwatchTab"
                        Grid.Column="1"
                        Content="STOPWATCH"
                        Style="{StaticResource GlassButtonStyle}"
                        Background="Transparent"
                        Foreground="#9AA8B8"
                        Padding="8,7"
                        Margin="2"/>

            </Grid>

            <!-- TIMER -->
            <Grid x:Name="TimerPanel"
                  Grid.Row="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TIME INPUTS -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <TextBlock Text="H"
                               Foreground="#8193A8"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"/>

                    <TextBox x:Name="HoursInput"
                             Text="00"
                             Width="42"
                             MaxLength="2"
                             Style="{StaticResource GlassTimeInputStyle}"
                             HorizontalContentAlignment="Center"
                             Margin="0,0,8,0"
                             Padding="4"/>

                    <TextBlock Text="M"
                               Foreground="#8193A8"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"/>

                    <TextBox x:Name="MinutesInput"
                             Text="05"
                             Width="42"
                             MaxLength="2"
                             Style="{StaticResource GlassTimeInputStyle}"
                             HorizontalContentAlignment="Center"
                             Margin="0,0,8,0"
                             Padding="4"/>

                    <TextBlock Text="S"
                               Foreground="#8193A8"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"/>

                    <TextBox x:Name="SecondsInput"
                             Text="00"
                             Width="42"
                             MaxLength="2"
                             Style="{StaticResource GlassTimeInputStyle}"
                             HorizontalContentAlignment="Center"
                             Padding="4"/>

                </StackPanel>

                <!-- TIMER PROGRESS -->
                <Grid Grid.Row="1"
                      MinHeight="210">

                <Grid Width="200"
                        Height="200"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <!-- Background ring -->
                        <Ellipse Width="176"
                                Height="176"
                                Stroke="#35FFFFFF"
                                StrokeThickness="5"
                                Fill="Transparent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        <!-- Soft glow behind the progress arc -->
                        <Path x:Name="GlowArc"
                            Stroke="#A6FFFFFF"
                            StrokeThickness="12"
                            Opacity="0.35"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Fill="Transparent"
                            IsHitTestVisible="False">
                            <Path.Effect>
                                <BlurEffect Radius="8"/>
                            </Path.Effect>
                        </Path>

                        <!-- Main progress arc -->
                        <Path x:Name="ProgressArc"
                            Stroke="#F4F7FC"
                            StrokeThickness="5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Fill="Transparent"
                            IsHitTestVisible="False"/>

                        <!-- Center display -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <TextBlock Text="TIME REMAINING"
                                    Foreground="#AEB8C6"
                                    FontSize="10"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,6"/>

                            <TextBlock x:Name="TimeDisplay"
                                        Text="05:00"
                                        Foreground="#F4F8FF"
                                        FontSize="30"
                                        FontWeight="Light"
                                        LineStackingStrategy="MaxHeight"
                                        Padding="0,4,0,6"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        TextAlignment="Center"/>

                            <TextBlock x:Name="StatusText"
                                    Text="READY"
                                    Foreground="#9CA6B5"
                                    FontSize="10"
                                    HorizontalAlignment="Center"
                                    Margin="0,5,0,0"/>

                        </StackPanel>

                    </Grid>
                </Grid>

                <!-- TIMER ALERT -->
                <TextBlock x:Name="TimerAlertText"
                           Grid.Row="2"
                           Text=" "
                           Foreground="#FFFF7777"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

                <!-- TIMER BUTTONS -->
                <Grid Grid.Row="3">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PrimaryButton"
                            Grid.Column="0"
                            Content="Start"
                            Style="{StaticResource GlassButtonStyle}"
                            Background="#35FFFFFF"
                            Foreground="White"
                            Padding="12,9"
                            Margin="3"/>

                    <Button x:Name="ResetButton"
                            Grid.Column="1"
                            Content="Reset"
                            Style="{StaticResource GlassButtonStyle}"
                            Margin="3"/>

                </Grid>
            </Grid>

            <!-- STOPWATCH -->
            <Grid x:Name="StopwatchPanel"
                  Grid.Row="1"
                  Visibility="Collapsed">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="STOPWATCH"
                           Foreground="#8193A8"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,10"/>

                <TextBlock x:Name="StopwatchDisplay"
                           Grid.Row="1"
                           Text="00:00.00"
                           Foreground="#F4F8FF"
                           FontSize="32"
                           FontWeight="Light"
                           LineStackingStrategy="MaxHeight"
                            Padding="0,4,0,6"
                            VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,20"/>

                <ListBox x:Name="LapList"
                         Grid.Row="2"
                         Background="#18000000"
                         Foreground="#DCE5F0"
                         BorderBrush="#2638495F"
                         Margin="3,0,3,8"
                         MinHeight="70"/>

                <!-- STOPWATCH BUTTONS -->
                <Grid Grid.Row="3">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="StopwatchPrimaryButton"
                            Grid.Column="0"
                            Content="Start"
                            Style="{StaticResource GlassButtonStyle}"
                            Background="#35FFFFFF"
                            Foreground="White"
                            Padding="8,9"
                            Margin="3"/>

                    <Button x:Name="LapButton"
                            Grid.Column="1"
                            Content="Lap"
                            Style="{StaticResource GlassButtonStyle}"
                            Padding="8,9"
                            Margin="3"/>

                    <Button x:Name="StopwatchResetButton"
                            Grid.Column="2"
                            Content="Reset"
                            Style="{StaticResource GlassButtonStyle}"
                            Padding="8,9"
                            Margin="3"/>

                </Grid>
            </Grid>

        </Grid>
    </Border>
</UserControl>