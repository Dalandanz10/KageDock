<Window x:Class="KageDock.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
        xmlns:views="clr-namespace:KageDock.Views"
        Title="KageDock"
        Width="820"
        Height="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Loaded="OnLoaded"
        PreviewMouseLeftButtonUp="DockWindow_PreviewMouseLeftButtonUp"
        Deactivated="OnWindowDeactivated"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>

        <!-- Existing header utility button style -->
        <Style x:Key="HeaderIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ButtonScale"
                                                    ScaleX="1"
                                                    ScaleY="1"/>
                                    <TranslateTransform x:Name="ButtonOffset"
                                                        Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="#24FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonOffset"
                                                Storyboard.TargetProperty="Y"
                                                To="-1"
                                                Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonOffset"
                                                Storyboard.TargetProperty="Y"
                                                To="0"
                                                Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Press -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="#40FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="0.92"
                                                Duration="0:0:0.07"/>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="0.92"
                                                Duration="0:0:0.07"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="1"
                                                Duration="0:0:0.12"/>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="1"
                                                Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Center navigation icons: no individual hover background -->
        <Style x:Key="NavIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="Transparent"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="NavButtonScale"
                                                    ScaleX="1"
                                                    ScaleY="1"/>
                                    <TranslateTransform x:Name="NavButtonOffset"
                                                        Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover: subtle lift, no background -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="NavButtonOffset"
                                                Storyboard.TargetProperty="Y"
                                                To="-1"
                                                Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>

                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="NavButtonOffset"
                                                Storyboard.TargetProperty="Y"
                                                To="0"
                                                Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Press: subtle compression -->
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="NavButtonScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="0.92"
                                                Duration="0:0:0.07"/>
                                            <DoubleAnimation
                                                Storyboard.TargetName="NavButtonScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="0.92"
                                                Duration="0:0:0.07"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>

                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="NavButtonScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="1"
                                                Duration="0:0:0.12"/>
                                            <DoubleAnimation
                                                Storyboard.TargetName="NavButtonScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="1"
                                                Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <Grid x:Name="RootDockGrid"
          Background="Transparent"
          ClipToBounds="False">
        <!-- Kage speech bubble: rendered behind the dock strip -->
    <Grid x:Name="KageBubbleAnchor"
        Width="100"
        Height="30"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        IsHitTestVisible="False">
        <Canvas>
            <views:KageSpeechBubble
                    x:Name="KageBubble"
                    Canvas.Left="94"
                    Canvas.Top="-8"/>
        </Canvas>
    </Grid>
        <!-- Host clips the dock to the animated visible height -->
        <Grid x:Name="DockRevealHost"
              Width="820"
              Height="28"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              ClipToBounds="True"
              Panel.ZIndex="1">

        <!-- Expanded dock surface: follows DockRevealHost size, never hit-testable -->
        <Grid x:Name="DockSurface"
            IsHitTestVisible="False"
            Visibility="{Binding Visibility, ElementName=ExpandedDockContent}">

            <Border x:Name="DockFill"
                    Background="#7012161C"
                    CornerRadius="0,0,18,18"/>

            <Border x:Name="GlassSurface"
                    Background="{StaticResource GlassBodyTintBrush}"
                    BorderBrush="{StaticResource GlassRimBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0,0,18,18"
                    SnapsToDevicePixels="True"/>
        </Grid>

        <Border x:Name="DockPanel"
                Width="820"
                Height="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0,0,18,18"
                ClipToBounds="False"
                MouseLeave="DockPanel_MouseLeave">

            <Grid ClipToBounds="False">


                    <!-- Expanded launcher content -->
                    <Grid x:Name="ExpandedDockContent"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"
                            RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="ContentSlideTransform"
                                                    X="0"
                                                    Y="0"/>
                            </Grid.RenderTransform>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                    <!-- Header -->
                    <Grid Grid.Row="0"
                        Margin="18,10,12,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TitleText"
                                Grid.Column="0"
                                Text="Apps"
                                Foreground="#F0F1F3"
                                Style="{StaticResource HeadingTextStyle}"
                                VerticalAlignment="Center"/>

                        <!-- Center navigation: icons only -->
                        <Grid x:Name="HeaderNavigation"
                            Grid.Column="1"
                            Width="132"
                            Height="38"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ClipToBounds="False">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>

                            <!-- Single sliding active indicator -->
                            <Border x:Name="NavActiveIndicator"
                                    Grid.Column="0"
                                    Width="36"
                                    Height="32"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#24FFFFFF"
                                    BorderBrush="#45FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="NavIndicatorTransform"
                                                        X="0"/>
                                </Border.RenderTransform>
                            </Border>

                            <!-- Apps -->
                            <Button x:Name="SectionsButton"
                                    Grid.Column="0"
                                    Style="{StaticResource NavIconButtonStyle}"
                                    Width="44"
                                    Height="38"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Apps"
                                    Click="SectionsButton_Click">
                                <svg:SvgViewbox Width="18"
                                                Height="18"
                                                Source="pack://siteoforigin:,,,/Assets/Icons/squares-four.svg"
                                                IsHitTestVisible="False"/>
                            </Button>

                            <!-- Music -->
                            <Button x:Name="MusicButton"
                                    Grid.Column="1"
                                    Style="{StaticResource NavIconButtonStyle}"
                                    Width="44"
                                    Height="38"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Music"
                                    Click="MusicButton_Click">
                                <svg:SvgViewbox Width="18"
                                                Height="18"
                                                Source="pack://siteoforigin:,,,/Assets/Icons/music-notes.svg"
                                                IsHitTestVisible="False"/>
                            </Button>

                            <!-- Timer -->
                            <Button x:Name="TimerButton"
                                    Grid.Column="2"
                                    Style="{StaticResource NavIconButtonStyle}"
                                    Width="44"
                                    Height="38"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Timer"
                                    Click="TimerButton_Click">
                                <svg:SvgViewbox Width="18"
                                                Height="18"
                                                Source="pack://siteoforigin:,,,/Assets/Icons/timer.svg"
                                                IsHitTestVisible="False"/>
                            </Button>
                        </Grid>

                        <!-- Right-side utility buttons: unchanged -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                            <Button x:Name="AddAppsHeaderButton"
                                    Style="{StaticResource HeaderIconButtonStyle}"
                                    Margin="3,0,3,0"
                                    Click="AddAppsButton_Click"
                                    ToolTip="Add Apps">
                                <svg:SvgViewbox Width="18"
                                                Height="18"
                                                Source="pack://siteoforigin:,,,/Assets/Icons/plus.svg"
                                                IsHitTestVisible="False"/>
                            </Button>

                            <Button x:Name="SettingsButton"
                                    Style="{StaticResource HeaderIconButtonStyle}"
                                    Click="SettingsButton_Click"
                                    ToolTip="Settings">
                                <svg:SvgViewbox Width="18"
                                                Height="18"
                                                Source="pack://siteoforigin:,,,/Assets/Icons/gear-six.svg"
                                                IsHitTestVisible="False"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Header divider -->
                        <Border Grid.Row="0"
                                Height="1"
                                Background="#26FFFFFF"
                                VerticalAlignment="Bottom"
                                Margin="40,0"/>


                        <Grid x:Name="ContentHost" Grid.Row="1">

                    <!-- Add Apps view host -->
                    <Grid x:Name="AddAppsContent"
                        Margin="12,6,12,6"
                        Background="Transparent"
                        Visibility="Collapsed"
                        Opacity="0"
                        IsHitTestVisible="False"
                        Panel.ZIndex="30"/>

                     </Grid>
                 </Grid>

                    <!-- Kage strip -->
                    <Border x:Name="KageStrip"
                            Width="100"
                            Height="30"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Background="#FF000000"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="0,0,8,8"
                            Visibility="Visible"
                            IsHitTestVisible="False">


                        <Grid ClipToBounds="True">


                            <views:KazeSunlitBreezeEffect
                                 x:Name="KazeSunlitBreeze"/>

                                <!-- Kage eyes -->
                        <Canvas x:Name="KageEyesCanvas"
                                UseLayoutRounding="False"
                                SnapsToDevicePixels="False"
                                IsHitTestVisible="False"
                                ClipToBounds="True"
                                RenderTransformOrigin="0.5,0.5">

                            <Canvas.RenderTransform>
                                <TranslateTransform x:Name="KageHeadShake"/>
                            </Canvas.RenderTransform>

                            <!-- Open eyes -->
                            <svg:SvgViewbox
                                x:Name="KageEyeLeft"
                                Width="24"
                                Height="13"
                                Canvas.Left="22"
                                Canvas.Top="8.5"
                                Source="pack://siteoforigin:,,,/Assets/Kage/KageEyeLeft.svg"
                                IsHitTestVisible="False"/>

                            <svg:SvgViewbox
                                x:Name="KageEyeRight"
                                Width="24"
                                Height="13"
                                Canvas.Left="54"
                                Canvas.Top="8.5"
                                Source="pack://siteoforigin:,,,/Assets/Kage/KageEyeRight.svg"
                                IsHitTestVisible="False"/>

                            <!-- Closed eyes -->
                            <svg:SvgViewbox
                                x:Name="KageEyeLeftClosed"
                                Width="24"
                                Height="13"
                                Canvas.Left="22"
                                Canvas.Top="8.5"
                                Source="pack://siteoforigin:,,,/Assets/Kage/KageEyeLeftClosed.svg"
                                Opacity="0"
                                IsHitTestVisible="False"/>

                            <svg:SvgViewbox
                                x:Name="KageEyeRightClosed"
                                Width="24"
                                Height="13"
                                Canvas.Left="54"
                                Canvas.Top="8.5"
                                Source="pack://siteoforigin:,,,/Assets/Kage/KageEyeRightClosed.svg"
                                Opacity="0"
                                IsHitTestVisible="False"/>
                                                </Canvas>

                        <views:KageEmberEffect x:Name="KageEmbers"/>

                        <views:KageYozakuraEffect x:Name="KageYozakura"/>

                        <views:KageCrimsonEffect x:Name="KageCrimson"/>

                        <!-- Kage expression effects -->
                        <Canvas x:Name="KageEffectCanvas"
                                Width="100"
                                Height="30"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False"
                                ClipToBounds="False"/>
                      </Grid>
                    </Border>

                </Grid>
            </Border>
        </Grid>

        <!-- Stationary, invisible hover target -->
        <Border x:Name="TopHoverTrigger"
                Width="160"
                Height="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="Transparent"
                IsHitTestVisible="True"
                MouseEnter="HitStrip_MouseEnter"
                MouseLeave="HitStrip_MouseLeave"
                Panel.ZIndex="10"/>

        <!-- Floating app icon while dragging -->
        <Canvas x:Name="DragOverlay"
                Panel.ZIndex="9999"
                IsHitTestVisible="False"
                ClipToBounds="False"/>

    </Grid>
</Window>
