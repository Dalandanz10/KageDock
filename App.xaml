<Application x:Class="KageDock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>

        <!-- Core glass palette -->
        <Color x:Key="GlassSurfaceColor">#18FFFFFF</Color>
        <Color x:Key="GlassContentColor">#20FFFFFF</Color>
        <Color x:Key="GlassEdgeColor">#80FFFFFF</Color>
        <Color x:Key="GlassHighlightColor">#38FFFFFF</Color>
        <Color x:Key="GlassShadowColor">#99000000</Color>

        <!-- KageDock fonts -->
        <FontFamily x:Key="InterFont">
            ./Assets/Fonts/Inter/static/#Inter
        </FontFamily>

        <FontFamily x:Key="ManropeFont">
            ./Assets/Fonts/Manrope/static/#Manrope
        </FontFamily>

        <!-- Default application typography -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily"
                    Value="{StaticResource InterFont}"/>
            <Setter Property="FontWeight"
                    Value="Normal"/>
        </Style>

        <!-- General UI text -->
        <Style x:Key="BodyTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily"
                    Value="{StaticResource InterFont}"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="FontWeight"
                    Value="Normal"/>
        </Style>

        <!-- Secondary UI labels -->
        <Style x:Key="SecondaryTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- Section headings -->
        <Style x:Key="HeadingTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="FontFamily"
                    Value="{StaticResource ManropeFont}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Large display values -->
        <Style x:Key="DisplayTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource HeadingTextStyle}">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Dark surface text colors -->
        <SolidColorBrush x:Key="TextPrimaryDark"
                         Color="#FFF7F8FC"/>
        <SolidColorBrush x:Key="TextSecondaryDark"
                         Color="#FFC5CBD5"/>
        <SolidColorBrush x:Key="TextMutedDark"
                         Color="#FF9CA6B5"/>

        <!-- Light surface text colors -->
        <SolidColorBrush x:Key="TextPrimaryLight"
                         Color="#FF171B23"/>
        <SolidColorBrush x:Key="TextSecondaryLight"
                         Color="#FF535D6B"/>
        <SolidColorBrush x:Key="TextMutedLight"
                         Color="#FF687386"/>

        <!-- Reusable glass brushes -->
        <SolidColorBrush x:Key="GlassSurfaceBrush"
                         Color="{StaticResource GlassSurfaceColor}"/>
        <SolidColorBrush x:Key="GlassContentBrush"
                         Color="{StaticResource GlassContentColor}"/>
        <SolidColorBrush x:Key="GlassEdgeBrush"
                         Color="{StaticResource GlassEdgeColor}"/>
        <SolidColorBrush x:Key="GlassHighlightBrush"
                         Color="{StaticResource GlassHighlightColor}"/>
        <SolidColorBrush x:Key="GlassShadowBrush"
                         Color="{StaticResource GlassShadowColor}"/>

        <!-- Glass body tint -->
        <LinearGradientBrush x:Key="GlassBodyTintBrush"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Color="#30FFFFFF" Offset="0"/>
            <GradientStop Color="#16FFFFFF" Offset="0.12"/>
            <GradientStop Color="#0AB8D8FF" Offset="0.45"/>
            <GradientStop Color="#0EFFFFFF" Offset="0.88"/>
            <GradientStop Color="#22FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Glass rim -->
        <LinearGradientBrush x:Key="GlassRimBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#A8FFFFFF" Offset="0"/>
            <GradientStop Color="#38FFFFFF" Offset="0.28"/>
            <GradientStop Color="#14FFFFFF" Offset="0.58"/>
            <GradientStop Color="#30FFFFFF" Offset="0.78"/>
            <GradientStop Color="#88FFFFFF" Offset="1"/>
        </LinearGradientBrush>

    </Application.Resources>
</Application>